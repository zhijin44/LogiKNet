    "results.to_csv(\"coherence_raw.csv\", index=False)\n",
    "summary.to_csv(\"coherence_summary.csv\", index=False)\n",
    "tl.to_csv(\"coherence_twolevel.csv\", index=False)\n",
    "print(\"saved coherence_{raw,summary,twolevel}.csv\")"
   ],
