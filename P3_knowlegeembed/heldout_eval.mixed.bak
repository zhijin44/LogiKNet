   "source": [
    "# ----------------------------- Aggregate -> mean +/- std -----------------------------\n",
    "# NOTE: always index the ground-truth column as results[\"gt\"], never results.gt --\n",
    "# `.gt` resolves to DataFrame.gt (the element-wise greater-than method), so `results.gt == g`\n",
    "# silently evaluates to the scalar False and selects zero rows. That was the cause of the\n",
    "# all-NaN summary table in the previous version of this notebook.\n",
    "METRICS = [\"auroc\", \"auprc\", \"auprc_lift\", \"base_rate\"]\n",
    "agg = results.groupby([\"model\", \"gt\", \"entity\"])[METRICS].agg([\"mean\", \"std\"])\n",
    "pd.set_option(\"display.float_format\", lambda x: f\"{x:.3f}\")\n",
    "print(agg)\n",
    "\n",
    "def _sel(model, g, e, col):\n",
    "    m = (results[\"model\"] == model) & (results[\"gt\"] == g) & (results[\"entity\"] == e)\n",
    "    return results.loc[m, col].dropna()\n",
    "\n",
    "def fmt(model, g, e, col):\n",
    "    s = _sel(model, g, e, col)\n",
    "    return f\"{s.mean():.3f} +/- {s.std():.3f}\" if len(s) else \"n/a\"\n",
    "\n",
    "summary = pd.DataFrame([\n",
    "    dict(GroundTruth=g, Entity=e,\n",
    "         PosRate   = f\"{_sel('LTN', g, e, 'base_rate').mean():.3f}\",\n",
    "         AUROC     = fmt(\"LTN\", g, e, \"auroc\"),\n",
    "         AUROC_rand= fmt(\"random\", g, e, \"auroc\"),\n",
    "         AUPRC     = fmt(\"LTN\", g, e, \"auprc\"),\n",
    "         AUPRC_rand= fmt(\"random\", g, e, \"auprc\"),\n",
    "         AUPRC_lift= fmt(\"LTN\", g, e, \"auprc_lift\"))\n",
    "    for g in [\"topological\", \"demand\"] for e in [\"node\", \"link\"]\n",
    "])\n",
    "assert summary.filter(like=\"AUROC\").ne(\"n/a\").all().all(), \"empty selection -- check column indexing\"\n",
    "summary"
   ]
  },
